{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mado-calendar",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mado-calendar",
      "database_id": "14c617a6-b253-4efe-a30b-18f23647f273",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [{ "pattern": "mado-cal.yuki-hiraishi.com", "custom_domain": true }],
  // 独自ドメイン以外（*.workers.dev）からは配信しない。Cookie と招待 URL のドメインを1つにするため
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "CALENDAR_SOURCE": "google"
  },
  "observability": { "enabled": true }
}
